# Frontend Environment Variables

# Backend origin, used only by the server-side proxy (never sent to the browser).
# Required for production builds. https only, no path. Do NOT add a NEXT_PUBLIC_ prefix.
BACKEND_URL=https://api.cropai.example.com

# Optional: Feature flags
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Environment
NODE_ENV=production
